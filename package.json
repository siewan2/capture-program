{
  "name": "capture-program",
  "version": "0.15.0",
  "private": true,
  "description": "Windows screen capture and annotation app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "test:desktop": "node scripts/desktop-smoke.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.siewan.captureprogram",
    "productName": "Capture Program",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Capture-Program-Setup-${version}.${ext}",
      "allowElevation": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
